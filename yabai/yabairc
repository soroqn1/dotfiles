#!/usr/bin/env sh

# ---------------------------------------------------------
# Scripting Addition (SA) Loader & Signals
# ---------------------------------------------------------
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# Route newly created windows to current space under mouse & auto-center modal dialogs
yabai -m signal --add event=window_created action='~/.config/yabai/on_window_created.sh'

# Scratchpad summon: follow to active space when opened ("закрыл и открылось там где нажал")
yabai -m signal --add event=application_activated app="^Telegram$" action='~/.config/yabai/summon_scratchpad.sh Telegram'
yabai -m signal --add event=application_activated app="^Finder$" action='~/.config/yabai/summon_scratchpad.sh Finder'

# ---------------------------------------------------------
# Layout & Compact Spacing (5pt - Optimized for 13" display)
# ---------------------------------------------------------
yabai -m config layout                      bsp
yabai -m config top_padding                 5
yabai -m config bottom_padding              5
yabai -m config left_padding                5
yabai -m config right_padding               5
yabai -m config window_gap                  5

# ---------------------------------------------------------
# Window Placement & Focus
# ---------------------------------------------------------
yabai -m config window_placement            second_child
yabai -m config focus_follows_mouse         off
yabai -m config mouse_follows_focus         off

# ---------------------------------------------------------
# Instant Response (0ms - No Stutter, No Tearing)
# ---------------------------------------------------------
yabai -m config window_animation_duration   0.0

# Disable shadows for tiled windows, keep for floating
yabai -m config window_shadow               float
yabai -m config window_opacity              off

# ---------------------------------------------------------
# Mouse Interaction Modifiers (Alt + Left/Right Click)
# ---------------------------------------------------------
yabai -m config mouse_modifier              alt
yabai -m config mouse_action1               move
yabai -m config mouse_action2               resize
yabai -m config mouse_drop_action           swap

# ---------------------------------------------------------
# Window Rules (Exclude System Popups & Dialogs)
# ---------------------------------------------------------
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^System Information$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Archive Utility$" manage=off
yabai -m rule --add app="^Activity Monitor$" manage=off
yabai -m rule --add app="^Preview$" manage=off grid=956:1470:235:128:1000:700
yabai -m rule --add subrole="^AXDialog$" manage=off
yabai -m rule --add subrole="^AXSystemDialog$" manage=off

# Floating Centered Apps (Wayland Scratchpad Style - Auto-reset on Cmd+W)
yabai -m rule --add app="^Telegram$" manage=off grid=956:1470:188:113:1094:730
yabai -m rule --add app="^Finder$" manage=off grid=956:1470:285:178:900:600
yabai -m rule --add app="^Messages$" manage=off grid=12:12:2:1:8:10

# Zen Browser (Floating PiP)
yabai -m rule --add app="^Zen$" title="^Picture-in-Picture$" manage=off

