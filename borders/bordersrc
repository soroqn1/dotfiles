#!/usr/bin/env sh

# Kill previous layout daemon if running
pkill -f borders_layout_daemon 2>/dev/null

borders \
  style=round \
  width=5.0 \
  hidpi=on \
  active_color="gradient(top_left=0xccffffff,bottom_right=0xcc86d1a5)" \
  inactive_color=0x2530535a \
  background_color=0x00000000 &

# Start native C daemon for 0ms layout borders sync
"$HOME/.config/borders/borders_layout_daemon" &
