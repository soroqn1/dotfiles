#!/usr/bin/env bash

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# ---------------------------------------------------------
# Bar Setup (Transparent overlay positioned beside native menubar)
# ---------------------------------------------------------
sketchybar --bar \
  height=32 \
  color=0x00000000 \
  border_width=0 \
  blur_radius=0 \
  y_offset=0 \
  margin=0 \
  padding_left=840 \
  padding_right=0 \
  position=top \
  topmost=window

# ---------------------------------------------------------
# Default Item Style (Native macOS Typography & Alignment)
# ---------------------------------------------------------
sketchybar --default \
  icon.font="SF Pro:Semibold:12.0" \
  icon.color=0x55ffffff \
  icon.highlight_color=0xffffffff \
  icon.padding_left=6 \
  icon.padding_right=6 \
  icon.y_offset=0 \
  label.drawing=off \
  padding_left=1 \
  padding_right=1 \
  y_offset=0 \
  background.height=22 \
  background.corner_radius=6 \
  background.border_width=0 \
  background.drawing=off

# Clean up previous items & brackets
sketchybar --remove '/space\..*/' spaces_capsule space_observer 2>/dev/null || true

# ---------------------------------------------------------
# Spaces (Minimalist native numbers)
# ---------------------------------------------------------
for sid in {1..10}; do
  sketchybar --add space "space.$sid" left \
    --set "space.$sid" \
      associated_space=$sid \
      icon="$sid" \
      icon.color=0x55ffffff \
      icon.highlight_color=0xffffffff \
      icon.padding_left=6 \
      icon.padding_right=6 \
      padding_left=1 \
      padding_right=1 \
      label.drawing=off \
      background.drawing=off \
      click_script="$PLUGIN_DIR/workspace.sh click $sid"
done

# ---------------------------------------------------------
# Observer for space changes
# ---------------------------------------------------------
sketchybar --add item space_observer left \
  --set space_observer \
    drawing=off \
    updates=on \
    script="$PLUGIN_DIR/workspace.sh" \
  --subscribe space_observer space_change display_change

"$PLUGIN_DIR/workspace.sh"

# Hide bar if yabai is not running
if ! pgrep -x yabai >/dev/null 2>&1; then
  sketchybar --bar hidden=on
fi
