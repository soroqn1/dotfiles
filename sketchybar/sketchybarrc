#!/usr/bin/env bash

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# Register AeroSpace custom events
sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_focus_change

# Bar configuration
# padding_left=840 anchors space.1 to the right of the MacBook notch (~825pt)
# Adding items on 'left' means they expand to the RIGHT when icons appear (away from the notch)
sketchybar --bar \
  height=32 \
  color=0x00000000 \
  border_width=0 \
  blur_radius=0 \
  y_offset=0 \
  margin=0 \
  padding_left=840 \
  padding_right=0 \
  position=top \
  topmost=window

# Global defaults for workspace pills
sketchybar --default \
  icon.font="JetBrainsMono Nerd Font:Bold:12.0" \
  icon.color=0xffffffff \
  icon.padding_left=7 \
  icon.padding_right=7 \
  icon.y_offset=0 \
  label.drawing=off \
  label.font="sketchybar-app-font:Regular:13.0" \
  label.y_offset=0 \
  padding_left=4 \
  padding_right=4 \
  background.height=23 \
  background.corner_radius=6 \
  background.drawing=off

# Add 9 workspace pills on the left (1 on left, 9 on right)
for sid in 1 2 3 4 5 6 7 8 9; do
  sketchybar --add item "space.$sid" left \
    --set "space.$sid" \
      icon="$sid" \
      click_script="aerospace workspace $sid"
done

# Single event observer (eliminates 9x parallel process execution & lag)
sketchybar --add item space_observer left \
  --set space_observer \
    drawing=off \
    script="$PLUGIN_DIR/workspace.sh" \
  --subscribe space_observer \
    aerospace_workspace_change \
    aerospace_focus_change \
    front_app_switched \
    space_windows_change \
    forced

# Initial update of workspace states
"$PLUGIN_DIR/workspace.sh"
