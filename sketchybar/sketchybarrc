#!/usr/bin/env bash

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# Anchor to the right of the MacBook notch (~825pt)
sketchybar --bar \
  height=32 \
  color=0x00000000 \
  border_width=0 \
  blur_radius=0 \
  y_offset=2 \
  margin=0 \
  padding_left=840 \
  padding_right=0 \
  position=top \
  topmost=window

sketchybar --default \
  icon.font="JetBrainsMono Nerd Font:Bold:12.0" \
  icon.color=0xffffffff \
  icon.highlight_color=0xffffffff \
  icon.padding_left=7 \
  icon.padding_right=7 \
  icon.y_offset=1 \
  label.drawing=off \
  label.font="sketchybar-app-font:Regular:13.0" \
  label.color=0xffffffff \
  label.highlight_color=0xffffffff \
  label.y_offset=1 \
  padding_left=4 \
  padding_right=4 \
  y_offset=1 \
  background.height=23 \
  background.corner_radius=6 \
  background.drawing=off

sketchybar --remove '/space\..*/' space_observer 2>/dev/null || true

for sid in {1..10}; do
  sketchybar --add space "space.$sid" left \
    --set "space.$sid" \
      associated_space=$sid \
      icon="$sid" \
      icon.color=0x90ffffff \
      icon.highlight_color=0xffffffff \
      icon.padding_left=8 \
      icon.padding_right=8 \
      background.color=0x14ffffff \
      background.border_color=0x20ffffff \
      background.border_width=1 \
      background.drawing=on \
      click_script="$PLUGIN_DIR/workspace.sh click $sid"
done

# Central observer for atomic batch updates across all spaces
sketchybar --add item space_observer left \
  --set space_observer \
    drawing=off \
    updates=on \
    update_freq=5 \
    script="$PLUGIN_DIR/workspace.sh" \
  --subscribe space_observer space_change space_windows_change front_app_switched display_change system_woke

"$PLUGIN_DIR/workspace.sh"
